{
  "name": "dsh-think-overlay",
  "version": "0.2.0",
  "description": "把 DSH 页面里的实时思考内容抽出来，做成一个可拖拽、可调透明度、可点击穿透的置顶悬浮窗；逐字流式、绿灯跟速、自动英译中，也能一键弹出成独立小窗。零外部依赖，安装即启用。",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "author": "hcycyxx",
  "keywords": ["dsh-plugin", "dsh", "deepseek-harness", "thinking", "reasoning", "overlay", "streaming", "悬浮窗", "思考"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "package.json", "README.md", "README.en.md", "CHANGELOG.md", "LICENSE", "docs/DISCOVER.md", "docs/images/overview.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcycyxx/dsh-think-overlay.git"
  },
  "homepage": "https://github.com/hcycyxx/dsh-think-overlay#readme",
  "bugs": {
    "url": "https://github.com/hcycyxx/dsh-think-overlay/issues"
  }
}
